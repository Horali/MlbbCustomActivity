DISCORD_APP_ID=paste_application_id_here
IGN=naradira
LEVEL=
LARGE_IMAGE=mlbb_icon
BADGE_PREFIX=party_
# 1 = small badge on the corner of the large image (party_1..5); off by default
BADGE_ICON=0
# Watch button: shows only when LIVE=1 and the URL is https
WATCH_URL=https://applink.mobilelegends.com/
LIVE=0
# 1 = match timer in Battle, 0 = session timer
MATCH_TIMER=0
# Optional: ADB=<path to adb.exe>, ADB_SERIAL=<serial>
# ClipMaker uses 8765 and 8766 on this PC: run the chat viewer with --port 8790
VIEWER_URL=http://127.0.0.1:8790/events
# Optional: the bridge starts the FixLag chat viewer while MLBB runs (skipped if the port is busy)
FIXLAG_DIR=C:/Users/child/PROJECTS/FixLag
# Optional: the bridge also starts the FixLag lag mapper (network logger) on this port
MAPPER_URL=http://127.0.0.1:8791/
# 1 = open one Chrome window (own profile) with a tab per tool while MLBB runs; it closes
# when MLBB stays closed for 60 s. CHROME=<path to chrome.exe> if Chrome is not found.
TOOL_TABS=1
# Phase 0 test script only
SMALL_IMAGE=squadog_3
HERO=Fanny
